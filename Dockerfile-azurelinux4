# syntax=docker.io/docker/dockerfile-upstream:1.9.0
# check=error=true

ARG BASE_IMAGE=mcr.microsoft.com/azurelinux/core:4@sha256:73a393085f44f1024d13578f97a638aad1af9d98f498c6b01d10741ce205ed56
FROM ${BASE_IMAGE} AS builder
RUN dnf5 -y --setopt=install_weak_deps=False install ca-certificates git python3 python3-pip && \
    dnf5 clean all
RUN git clone https://github.com/upa/deadman.git /tmp/deadman && \
    git -C /tmp/deadman checkout 4746fd6aae3625b44e19cb3cac566e0544c04dc9 && \
    rm -rf /tmp/deadman/.git
RUN python3 -m venv --without-pip /opt/speedtest && \
    printf '%s\n' 'speedtest-cli==2.1.3 --hash=sha256:75ff32c91af9ac1ce2b905476d6e92bd9eb2c0783f9e7d1939d74605c7d0b9ea' > /tmp/requirements.txt && \
    python3 -m pip --python /opt/speedtest install --no-cache-dir --require-hashes --only-binary=:all: -r /tmp/requirements.txt && \
    /opt/speedtest/bin/speedtest-cli --version

FROM ${BASE_IMAGE}
LABEL org.opencontainers.image.title="Debug Container (Azure Linux 4)" \
      org.opencontainers.image.source="https://github.com/pichuang/debug-container" \
      org.opencontainers.image.description="Container troubleshooting tools on Azure Linux 4" \
      org.opencontainers.image.documentation="https://github.com/pichuang/debug-container" \
      org.opencontainers.image.base.name="mcr.microsoft.com/azurelinux/core:4"

RUN dnf5 -y --setopt=install_weak_deps=False install \
        bind-utils \
        ca-certificates \
        curl \
        ethtool \
        git \
        iperf3 \
        iproute \
        iputils \
        jq \
        mtr \
        net-tools \
        nmap \
        nmap-ncat \
        numactl \
        procps-ng \
        python3 \
        python3-pip \
        sysstat \
        tcpdump \
        vim-enhanced \
        wget2 && \
    dnf5 clean all

COPY --from=builder /tmp/deadman /root/deadman
COPY --from=builder /opt/speedtest /opt/speedtest
COPY motd /etc/motd
RUN ln -s /opt/speedtest/bin/speedtest-cli /usr/local/bin/speedtest-cli && \
    printf '\ncat /etc/motd\n' >> /root/.bashrc

EXPOSE 5566
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD ["/bin/bash", "-c", "command -v ip && test -x /root/deadman/deadman"]

WORKDIR /root
ENV HOSTNAME=debug-container
CMD ["/bin/bash", "-l"]
